{
  "name": "zeliard-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "assets": "node ../scripts/copy_assets.mjs",
    "hybrid:assets": "node ../scripts/build-hybrid-dos-image.mjs",
    "hybrid:capture": "node capture_hybrid_masm_frames.mjs",
    "hybrid:verify": "node verify_hybrid_masm_capture.mjs",
    "opening:compare": "node run_opening_parity_capture.mjs",
    "opening:audio-test": "node test_opening_audio_browser.mjs",
    "castle:audio-test": "node test_castle_audio_browser.mjs",
    "audio-worklet:test": "node test_audio_worklet.mjs",
    "castle:inventory-test": "node test_castle_inventory_browser.mjs",
    "rooms:browser-test": "node test_felishika_rooms_browser.mjs",
    "muralla:browser-test": "node test_muralla_browser.mjs",
    "cavern:browser-test": "node test_cavern_transition_browser.mjs",
    "peligro:browser-test": "node test_peligro_browser.mjs",
    "escarcha:browser-test": "node test_escarcha_browser.mjs",
    "shops:animation-test": "node test_shop_animations_browser.mjs",
    "bank:input-test": "node test_bank_input_browser.mjs",
    "sage:save-test": "node test_sage_save_browser.mjs",
    "engine": "$(MAKE) -C ../engine wasm",
    "build:engine": "cd ../engine && make wasm",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "playwright": "^1.61.0",
    "typescript": "~5.4.5",
    "vite": "~5.2.10"
  },
  "dependencies": {
    "v86": "^0.5.424"
  }
}
