    },
    "entries": [
      {
        "runtime_si": "6FF0",
        "text": "           Two thousand years, ",
        "terminator": "0D"
      },
      {
        "runtime_si": "7010",
        "text": "from the dark reaches of another galaxy,",
        "terminator": "0D"
      },
      {
        "runtime_si": "7039",
        "text": "        a demon with not a shred",
        "terminator": "0D"
      },
      {
        "runtime_si": "705A",
        "text": "      of compassion for humankind,",
        "terminator": "0D"
      },
      {
        "runtime_si": "707D",
        "text": "         descended upon earth.",
        "terminator": "0D"
      },
      {
        "runtime_si": "709C",
        "text": "",
        "terminator": "0D"
      },
      {
        "runtime_si": "709D",
        "text": "          He defiled the land,",
        "terminator": "0D"
      },
      {
        "runtime_si": "70BC",
        "text": "  sending vile creatures to live in it,",
        "terminator": "0D"
      },
      {
        "runtime_si": "70E4",
        "text": "   and thus became ruler of the world.",
        "terminator": "0D"
      },
      {
        "runtime_si": "710B",
        "text": "",
        "terminator": "0D"
      },
      {
        "runtime_si": "710C",
        "text": "         The King of Felishika,",
        "terminator": "0D"
      },
      {
        "runtime_si": "712C",
        "text": "     appalled by what had happened,",
        "terminator": "0D"
      },
      {
        "runtime_si": "7150",
        "text": "          prayed to the Spirit",
        "terminator": "0D"
      },
      {
        "runtime_si": "716F",
        "text": "      of the Holy Land of Zeliard",
        "terminator": "0D"
      },
      {
        "runtime_si": "7191",
        "text": "    for help in defeating this monster.",
        "terminator": "0D"
      },
      {
        "runtime_si": "71B9",
        "text": "",
        "terminator": "0D"
      },
      {
        "runtime_si": "71BA",
        "text": "    With the help of the holy crystals",
        "terminator": "0D"
      },
      {
        "runtime_si": "71E1",
        "text": "       called Tears of Esmesanti,",
        "terminator": "0D"
      },
      {
        "runtime_si": "7203",
        "text": "    the King managed to wrest power",
        "terminator": "0D"
      },
      {
        "runtime_si": "7227",
        "text": "    from the fiend and seal him deep",
        "terminator": "0D"
      },
      {
        "runtime_si": "724C",
        "text": "     within the bowels of the earth.",
        "terminator": "0D"
      },
      {
        "runtime_si": "7271",
        "text": "",
        "terminator": "0D"
      },
      {
        "runtime_si": "7272",
        "text": "            And once again,",
        "terminator": "0D"
      },
      {
        "runtime_si": "728E",
        "text": " the light of peace came to shine upon",
        "terminator": "0D"
      },
      {
        "runtime_si": "72B5",
        "text": "              the earth.",
        "terminator": "0D"
      },
      {
        "runtime_si": "72CE",
        "text": "",
        "terminator": "0D"
      },
      {
        "runtime_si": "72CF",
        "text": "",
        "terminator": "0D"
      },
      {
        "runtime_si": "72D0",
        "text": "However, it is written in",
        "terminator": "0D"
      },
      {
        "runtime_si": "72EA",
        "text": "       the Sixth Book of Esmesanti:",
        "terminator": "0D"
      },
      {
        "runtime_si": "730E",
        "text": "                    The Age of Darkness.",
        "terminator": "0D"
      },
      {
        "runtime_si": "7337",
        "text": "",
        "terminator": "FF"
      }
    ],
