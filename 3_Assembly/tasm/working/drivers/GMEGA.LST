      3				     ;==========================================================================
      4				     ;
      5				     ;	GMEGA.BIN - EGA	16-Color Graphics Driver (Mode 0Eh, 640x200)
      6				     ;
      7				     ;	EGA variant of the graphics driver API.	Uses EGA planar	memory
      8				     ;	at 0xA000 with Map Mask	and Bit	Mask registers for pixel access.
      9				     ;
     10				     ;==========================================================================
     11
     12	      =	5432		     target	     EQU   'T2'			     ; Target assembler: TASM-2.X
     13
     14				     include  srmacros.inc
1    15
1    16				     ; Macros which may	be required for	proper re-assembly
1    17
1    18
1    19
1    20
1    21
1    22				     ;-----------------------------------------------------------------------------
1    23				     ; Some assemblers,	like TASM, check each far call and jump, to see	if it is
1    24				     ; in the same segment.  If	so, rather than	produce	the standard five byte far
1    25				     ; instruction it uses a near jump or call.
1    26
1    27				     calls	     macro   dummy1, dummy2, slocation
1    28						     db	     9Ah		     ; forced call far instruction
1    29						     dw	     offset slocation, seg slocation
1    30				     endm
1    31
1    32				     jmps	     macro   dummy1, dummy2, jlocation
1    33						     db	     0EAh		     ; forced jump far instruction
1    34						     dw	     offset jlocation, seg jlocation
1    35				     endm
1    36
1    37
1    38
1    39
1    40				     ;-----------------------------------------------------------------------------
1    41				     ;	Some compilers and some	assemblers will	code a call that goes to a far
1    42				     ;	subroutine in the same segment as:
1    43				     ;
1    44				     ;		     PUSH    CS
1    45				     ;		     CALL    near
1    46				     ;
1    47				     ;	This saves one byte, and is slightly faster.  If the assembler you are
1    48				     ;	using (i.e. MASM, Optasm) does not do this automatically, the following
1    49				     ;	macros are used	to code	the same information.  In other	words, the binary
1    50				     ;	file has "PUSH CS, CALL	near", and Sourcer ensures the same instructions
1    51				     ;	are used!  (macro CALLF)
1    52				     ;
1    53
1    54				     callf	     macro   location
Turbo Assembler	 Version 2.01	     03/27/26 10:34:28	    Page 2
gmega.asm



1    55						     push    cs
1    56						     call    near ptr location
1    57				     endm
1    58
1    59				     ;	Some compilers generate	an unnecessary DS override on the call instruction
1    60				     ;	when compacting	the CALLF type function.  Macro	CALLFX handles this case.
1    61
1    62				     callfx	     macro   location
1    63						     push    cs
1    64						     db	     3Eh
1    65						     call    near ptr location
1    66				     endm
1    67
1    68
1    69				     ;-----------------------------------------------------------------------------
1    70				     ;	Some compilers and some	assemblers will	code a near call that is the
1    71				     ;	selected assembler will	convert	to a short jump	to save	a byte.	 This
1    72				     ;	reconstructs a near jump for these cases.
1    73
1    74				     jmpn	     macro   location
1    75						     db	     0E9h
1    76						     dw	     offset location-$-2
1    77				     endm
1    78
