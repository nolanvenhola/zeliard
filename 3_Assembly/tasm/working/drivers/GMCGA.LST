    126				     ; stdply.bin player state field offsets (shared with all gm*.bin drivers)
    127				     include  stdply.inc
1   128				     ;==========================================================================
1   129				     ;
1   130				     ;	stdply.inc - Shared field offsets for stdply.bin player	state block
1   131				     ;
1   132				     ;	stdply.bin loads at game_entry_seg:0000h. All graphics drivers (gm*.bin)
1   133				     ;	run in the same	segment	and access this	data via CS-relative addresses.
1   134				     ;
1   135				     ;	Include	this file in every driver that reads stdply state fields.
1   136				     ;	If stdply.asm's	layout changes,	update the EQUs	here — all drivers
1   137				     ;	pick up	the change automatically.
1   138				     ;
1   139				     ;==========================================================================
1   140
1   141				     ; Player config bytes  [0x0080-0x0084]
1   142	      =	0080		     ply_walk_speed	     equ     80h     ; walk speed (init	0x1E = 30)
1   143	      =	0083		     ply_accel		     equ     83h     ; movement	acceleration x,y (init 0x0A each)
1   144
1   145				     ; Timer / display state  [0x0085-0x008F]
1   146	      =	0085		     drv_timer_flag	     equ     85h     ; timer display active flag
1   147	      =	0086		     drv_time_param_a	     equ     86h     ; timestamp low byte
1   148	      =	008B		     drv_time_param_b	     equ     8Bh     ; timestamp high byte
1   149
1   150				     ; Text / animation	state  [0x0090-0x00AA]
1   151	      =	0090		     drv_text_src	     equ     90h     ; text source stride (init	0x50 = 80)
1   152	      =	0092		     ply_jump_flag	     equ     92h     ; jump enable flag	(init 1)
1   153	      =	0093		     drv_sprite_flag	     equ     93h     ; sprite display active flag
1   154	      =	0094		     drv_time_param_c	     equ     94h     ; time counter byte
1   155	      =	009D		     drv_frame_idx	     equ     9Dh     ; animation frame index (1-based; 0=none)
1   156
1   157				     ; Animation color LUT  [0x00AB-0x00C3]
1   158	      =	00AB		     drv_color_lut	     equ     0ABh    ; base: cs:[drv_color_lut + frame - 1]
1   159
