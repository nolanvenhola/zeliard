      3				     ;==========================================================================
      4				     ;
      5				     ;	GMMCGA.BIN - MCGA/VGA 256-Color	Graphics Driver	(Mode 13h, 320x200)
      6				     ;
      7				     ;	Graphics primitives for	VGA framebuffer	at 0xA000:0000:
      8				     ;	- Screen clear,	pixel plot, line fill (horizontal/vertical)
      9				     ;	- Rectangle fill
     10				     ;	- Text character rendering (8x8	with color)
     11				     ;	- Tilemap rendering (large 6x7 glyphs from font_ptr_b, small 16x16 sprites)
     12				     ;	- 3-bitplane sprite decoding (3	bits per pixel,	8 colors)
     13				     ;	- Time/BCD formatting utilities
     14				     ;
     15				     ;	VGA row	stride:	320 bytes (0x140)
     16				     ;
     17				     ;	Code type: zero	start
     18				     ;	Created:   16-Feb-26
     19				     ;	Passes:	   9	      Analysis Options on: none
     20				     ;
     21				     ;==========================================================================
     22
     23	      =	5432		     target	     EQU   'T2'			     ; Target assembler: TASM-2.X
     24
     25				     include  srmacros.inc
1    26
1    27				     ; Macros which may	be required for	proper re-assembly
1    28
1    29
1    30
1    31
1    32
1    33				     ;-----------------------------------------------------------------------------
1    34				     ; Some assemblers,	like TASM, check each far call and jump, to see	if it is
1    35				     ; in the same segment.  If	so, rather than	produce	the standard five byte far
1    36				     ; instruction it uses a near jump or call.
1    37
1    38				     calls	     macro   dummy1, dummy2, slocation
1    39						     db	     9Ah		     ; forced call far instruction
1    40						     dw	     offset slocation, seg slocation
1    41				     endm
1    42
1    43				     jmps	     macro   dummy1, dummy2, jlocation
1    44						     db	     0EAh		     ; forced jump far instruction
1    45						     dw	     offset jlocation, seg jlocation
1    46				     endm
1    47
1    48
1    49
1    50
1    51				     ;-----------------------------------------------------------------------------
1    52				     ;	Some compilers and some	assemblers will	code a call that goes to a far
1    53				     ;	subroutine in the same segment as:
1    54				     ;
Turbo Assembler	 Version 2.01	     04/05/26 15:17:28	    Page 2
gmmcga.asm



1    55				     ;		     PUSH    CS
1    56				     ;		     CALL    near
1    57				     ;
1    58				     ;	This saves one byte, and is slightly faster.  If the assembler you are
1    59				     ;	using (i.e. MASM, Optasm) does not do this automatically, the following
1    60				     ;	macros are used	to code	the same information.  In other	words, the binary
1    61				     ;	file has "PUSH CS, CALL	near", and Sourcer ensures the same instructions
1    62				     ;	are used!  (macro CALLF)
1    63				     ;
1    64
1    65				     callf	     macro   location
1    66						     push    cs
1    67						     call    near ptr location
1    68				     endm
1    69
1    70				     ;	Some compilers generate	an unnecessary DS override on the call instruction
1    71				     ;	when compacting	the CALLF type function.  Macro	CALLFX handles this case.
1    72
1    73				     callfx	     macro   location
1    74						     push    cs
1    75						     db	     3Eh
1    76						     call    near ptr location
1    77				     endm
1    78
1    79
1    80				     ;-----------------------------------------------------------------------------
1    81				     ;	Some compilers and some	assemblers will	code a near call that is the
1    82				     ;	selected assembler will	convert	to a short jump	to save	a byte.	 This
1    83				     ;	reconstructs a near jump for these cases.
1    84
1    85				     jmpn	     macro   location
1    86						     db	     0E9h
1    87						     dw	     offset location-$-2
1    88				     endm
