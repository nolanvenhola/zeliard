1   136				     ;==========================================================================
1   137				     ;
1   138				     ;	stdply.inc - Shared field offsets for stdply.bin player	state block
1   139				     ;
1   140				     ;	stdply.bin loads at game_entry_seg:0000h. All graphics drivers (gm*.bin)
1   141				     ;	run in the same	segment	and access this	data via CS-relative addresses.
1   142				     ;
1   143				     ;	Include	this file in every driver that reads stdply state fields.
1   144				     ;	If stdply.asm's	layout changes,	update the EQUs	here — all drivers
1   145				     ;	pick up	the change automatically.
1   146				     ;
1   147				     ;==========================================================================
1   148
1   149				     ; Player config bytes  [0x0080-0x0084]
1   150	      =	0080		     ply_walk_speed	     equ     80h     ; walk speed (init	0x1E = 30)
1   151	      =	0083		     ply_accel		     equ     83h     ; movement	acceleration x,y (init 0x0A each)
1   152
1   153				     ; Timer / display state  [0x0085-0x008F]
1   154	      =	0085		     drv_timer_flag	     equ     85h     ; timer display active flag
1   155	      =	0086		     drv_time_param_a	     equ     86h     ; timestamp low byte
1   156	      =	008B		     drv_time_param_b	     equ     8Bh     ; timestamp high byte
1   157
1   158				     ; Text / animation	state  [0x0090-0x00AA]
1   159	      =	0090		     drv_text_src	     equ     90h     ; text source stride (init	0x50 = 80)
1   160	      =	0092		     ply_jump_flag	     equ     92h     ; jump enable flag	(init 1)
1   161	      =	0093		     drv_sprite_flag	     equ     93h     ; sprite display active flag
1   162	      =	0094		     drv_time_param_c	     equ     94h     ; time counter byte
