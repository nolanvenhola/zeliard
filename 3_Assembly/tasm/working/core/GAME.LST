    600				     ;	Inner palette loop: for	each base color	(8 iterations)
    601	0425			     palette_base_loop:
    602	0425  51				     push    cx
    603	0426  AC				     lodsb			     ; Red base
    604	0427  8A F0				     mov     dh,al
    605	0429  AC				     lodsb			     ; Green base
    606	042A  8A D0				     mov     dl,al
    607	042C  AC				     lodsb			     ; Blue base
    608	042D  8A E0				     mov     ah,al
