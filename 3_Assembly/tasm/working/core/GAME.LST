    518				     ;==========================================================================
    519				     ;	load_music_tracks - Load all configured	music tracks
    520				     ;
    521				     ;	Reads music track count	from [ds:0xA0],	iterates through track table
    522				     ;	at level_data_ref (0xA3F2), and	calls sound driver track-load fn for each.
    523				     ;	Track 8	gets special flag (AL=1) for background	music.
    524				     ;==========================================================================
    525
    526	03A5			     load_music_tracks proc  near
    527	03A5  F6 06 00A0 FF			     test    byte ptr ds:[0A0h],0FFh
    528	03AA  75 01				     jnz     has_tracks
    529	03AC  C3				     retn
    530
    531	03AD			     has_tracks:
    532	03AD  8A 0E 00A0			     mov     cl,byte ptr ds:[0A0h]   ; Track count
    533	03B1  32 ED				     xor     ch,ch
    534	03B3  33 DB				     xor     bx,bx		     ; Track index
    535
    536	03B5			     load_track_loop:
    537	03B5  51				     push    cx
    538	03B6  53				     push    bx
    539	03B7  8B D3				     mov     dx,bx
    540	03B9  03 DB				     add     bx,bx
Turbo Assembler	 Version 2.01	     03/27/26 10:05:56	    Page 11
game.asm



    541	03BB  8B 9F A3D3r			     mov     bx,ds:level_system_ref[bx]	; Get track chunk ref
    542	03BF  32 C0				     xor     al,al
    543	03C1  83 FA 08				     cmp     dx,8		     ; Track 8 = background music
    544	03C4  75 02				     jne     not_bg_music
    545	03C6  B0 01				     mov     al,1		     ; Flag for	background track
    546	03C8			     not_bg_music:
    547	03C8  2E: FF 16	203E			     call    word ptr cs:sound_load_track_fn ; Load/init track via sound driver
    548	03CD  5B				     pop     bx
    549	03CE  43				     inc     bx
    550	03CF  59				     pop     cx
    551	03D0  E2 E3				     loop    load_track_loop
    552
    553	03D2  C3				     retn
