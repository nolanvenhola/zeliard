    562	03E9  32 FF				     xor     bh,bh
    563	03EB  03 DB				     add     bx,bx
    564	03ED  2E: FF A7	A3F2			     jmp     word ptr cs:level_data_ref[bx] ; Jump to mode handler
    565	03F2			     set_vga_palette endp
