    553				     ;	set_vga_palette	- Set VGA DAC palette based on graphics	mode
    554				     ;
    555				     ;	Uses gvar_game_phase as	index into mode-specific palette setup.
    556				     ;	For MCGA mode: programs	64 VGA DAC registers (8	base colors x 8	shades)
    557				     ;	using RGB triplets from	a base color table + shade offset table.
    558				     ;==========================================================================
    559
    560	03E5			     set_vga_palette proc    near
