    610	0430  BE A456r				     mov     si,palette_base_tbl     ; Base RGB	color table (8 triplets)
    611	0433  B9 0008				     mov     cx,8		     ; 8 shades	per base
    612
    613				     ;	For each shade:	add offset to base RGB,	program	DAC register
    614	0436			     palette_shade_loop:
    615	0436  51				     push    cx
    616	0437  50				     push    ax
    617	0438  52				     push    dx
