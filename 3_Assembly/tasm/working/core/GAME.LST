    565				     ;	set_vga_palette	- Set VGA DAC palette based on graphics	mode
    566				     ;
    567				     ;	Uses gvar_game_phase as	index into mode-specific palette setup.
    568				     ;	For MCGA mode: programs	64 VGA DAC registers (8	base colors x 8	shades)
    569				     ;	using RGB triplets from	a base color table + shade offset table.
    570				     ;==========================================================================
