      3				     ;==========================================================================
      4				     ;
      5				     ;	GAME.BIN - Main	Game Initialization & Resource Loader
      6				     ;
      7				     ;	Loaded by zeliad.exe into memory, then called to start the game.
      8				     ;	Loads SAR archive chunks, initializes graphics/sound drivers,
      9				     ;	sets up	palettes, and jumps to the main	gameplay loop.
     10				     ;
     11				     ;	Code type: zero	start (loaded at base of segment, runs from offset 0)
     12				     ;	Created:   16-Feb-26
     13				     ;	Passes:	   9	      Analysis Options on: none
     14				     ;
     15				     ;==========================================================================
     16
     17	      =	5432		     target	     EQU   'T2'			     ; Target assembler: TASM-2.X
     18
     19				     include  srmacros.inc
1    20
1    21				     ; Macros which may	be required for	proper re-assembly
1    22
1    23
1    24
1    25
1    26
1    27				     ;-----------------------------------------------------------------------------
1    28				     ; Some assemblers,	like TASM, check each far call and jump, to see	if it is
1    29				     ; in the same segment.  If	so, rather than	produce	the standard five byte far
1    30				     ; instruction it uses a near jump or call.
1    31
1    32				     calls	     macro   dummy1, dummy2, slocation
1    33						     db	     9Ah		     ; forced call far instruction
1    34						     dw	     offset slocation, seg slocation
1    35				     endm
1    36
1    37				     jmps	     macro   dummy1, dummy2, jlocation
1    38						     db	     0EAh		     ; forced jump far instruction
1    39						     dw	     offset jlocation, seg jlocation
1    40				     endm
1    41
1    42
1    43
1    44
1    45				     ;-----------------------------------------------------------------------------
1    46				     ;	Some compilers and some	assemblers will	code a call that goes to a far
1    47				     ;	subroutine in the same segment as:
1    48				     ;
1    49				     ;		     PUSH    CS
1    50				     ;		     CALL    near
1    51				     ;
1    52				     ;	This saves one byte, and is slightly faster.  If the assembler you are
1    53				     ;	using (i.e. MASM, Optasm) does not do this automatically, the following
1    54				     ;	macros are used	to code	the same information.  In other	words, the binary
Turbo Assembler	 Version 2.01	     03/22/26 11:45:12	    Page 2
game.asm



1    55				     ;	file has "PUSH CS, CALL	near", and Sourcer ensures the same instructions
1    56				     ;	are used!  (macro CALLF)
1    57				     ;
1    58
1    59				     callf	     macro   location
1    60						     push    cs
1    61						     call    near ptr location
1    62				     endm
1    63
1    64				     ;	Some compilers generate	an unnecessary DS override on the call instruction
1    65				     ;	when compacting	the CALLF type function.  Macro	CALLFX handles this case.
1    66
1    67				     callfx	     macro   location
1    68						     push    cs
1    69						     db	     3Eh
1    70						     call    near ptr location
1    71				     endm
1    72
1    73
1    74				     ;-----------------------------------------------------------------------------
1    75				     ;	Some compilers and some	assemblers will	code a near call that is the
1    76				     ;	selected assembler will	convert	to a short jump	to save	a byte.	 This
1    77				     ;	reconstructs a near jump for these cases.
1    78
1    79				     jmpn	     macro   location
1    80						     db	     0E9h
1    81						     dw	     offset location-$-2
1    82				     endm
1    83
1    84
1    85
