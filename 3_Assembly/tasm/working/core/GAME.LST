    136				     ;==========================================================================
    137				     ;
    138				     ;	Game Entry Point
    139				     ;
    140				     ;	Called from zeliad.exe with AX = mode flag:
    141				     ;	  AX = 0      New game
    142				     ;	  AX = 0xFFFF Load saved game
    143				     ;
    144				     ;	Initialization flow:
    145				     ;	  1. Load SAR chunk loader / jump table
    146				     ;	  2. Clear all game state variables
    147				     ;	  3. Load graphics driver for current video mode
    148				     ;	  4. Branch: new game vs. load save
    149				     ;	  5. Load all game subsystems (physics,	combat,	AI, etc.)
    150				     ;	  6. Initialize	palette, music,	level data
    151				     ;	  7. Jump to main game loop
    152				     ;
    153				     ;==========================================================================
    154
    155	0000			     game	     proc    far
    156
    157	0000			     start:
    158	0000  2E: A3 A474			     mov     cs:save_mode_flag,ax    ; Save new/load flag
    159	0004  8C C8				     mov     ax,cs
    160	0006  8E D8				     mov     ds,ax
    161	0008  0E				     push    cs
    162	0009  07				     pop     es
