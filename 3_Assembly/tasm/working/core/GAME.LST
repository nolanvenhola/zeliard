    507				     ;==========================================================================
    508				     ;	load_music_tracks - Load all configured	music tracks
    509				     ;
    510				     ;	Reads music track count	from [ds:0xA0],	iterates through track table
    511				     ;	at level_data_ref (0xA3F2), and	calls sound driver track-load fn for each.
    512				     ;	Track 8	gets special flag (AL=1) for background	music.
    513				     ;==========================================================================
    514
    515	03A5			     load_music_tracks proc  near
    516	03A5  F6 06 00A0 FF			     test    byte ptr ds:[0A0h],0FFh
    517	03AA  75 01				     jnz     has_tracks
    518	03AC  C3				     retn
    519
    520	03AD			     has_tracks:
    521	03AD  8A 0E 00A0			     mov     cl,byte ptr ds:[0A0h]   ; Track count
    522	03B1  32 ED				     xor     ch,ch
    523	03B3  33 DB				     xor     bx,bx		     ; Track index
    524
    525	03B5			     load_track_loop:
    526	03B5  51				     push    cx
    527	03B6  53				     push    bx
    528	03B7  8B D3				     mov     dx,bx
    529	03B9  03 DB				     add     bx,bx
    530	03BB  8B 9F A3D3			     mov     bx,ds:level_system_ref[bx]	; Get track chunk ref
    531	03BF  32 C0				     xor     al,al
    532	03C1  83 FA 08				     cmp     dx,8		     ; Track 8 = background music
    533	03C4  75 02				     jne     not_bg_music
    534	03C6  B0 01				     mov     al,1		     ; Flag for	background track
    535	03C8			     not_bg_music:
    536	03C8  2E: FF 16	203E			     call    word ptr cs:sound_load_track_fn ; Load/init track via sound driver
    537	03CD  5B				     pop     bx
    538	03CE  43				     inc     bx
    539	03CF  59				     pop     cx
    540	03D0  E2 E3				     loop    load_track_loop
