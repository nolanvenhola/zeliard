    139				     ;==========================================================================
    140				     ;
    141				     ;	Program	Entry Point
    142				     ;
    143				     ;	1. Check DOS version >=	2.0
    144				     ;	2. Parse RESOURCE.CFG (graphics	mode, music driver, joystick, options)
    145				     ;	3. Allocate memory, load driver	files
    146				     ;	4. Initialize game state variables
    147				     ;	5. Set video mode
    148				     ;	6. Jump	to game.bin entry point
    149				     ;
    150				     ;==========================================================================
    151
    152	0000			     zeliad	     proc    far
    153
    154	0000			     start:
    155	0000  FC				     cld
    156	0001  B4 30				     mov     ah,30h
    157	0003  CD 21				     int     21h		     ; Get DOS version
    158	0005  3C 02				     cmp     al,2
    159	0007  73 02				     jae     dos_version_ok
    160	0009  CD 20				     int     20h		     ; Exit if DOS < 2.0
    161
    162	000B			     dos_version_ok:
