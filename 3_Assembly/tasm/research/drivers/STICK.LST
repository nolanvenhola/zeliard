      3				     ;==========================================================================
      4				     ;
      5				     ;	STICK.BIN - Joystick & Keyboard	Input Driver
      6				     ;
      7				     ;	Interrupt-driven multi-input driver supporting:
      8				     ;	- Keyboard scanning with remappable scan codes
      9				     ;	- Joystick support with	dead zone calibration (port 201h)
     10				     ;	- Pause/menu state management
     11				     ;	- Save/load game file I/O with compression
     12				     ;	- Game state machine (pause, exit dialogs)
     13				     ;
     14				     ;	Entry Points (jump table at offset 0):
     15				     ;	  +0x00	 Keyboard IRQ handler (INT 09h replacement)
     16				     ;	  +0x03	 Joystick/input	polling	(called	from INT 08h timer)
     17				     ;	  +0x06	 Game state handler (pause/exit	dialogs)
     18				     ;	  +0x09	 Input state query (returns current button/direction)
     19				     ;
     20				     ;	Code type: zero	start
     21				     ;	Created:   16-Feb-26
     22				     ;	Passes:	   9	      Analysis Options on: none
     23				     ;
     24				     ;==========================================================================
     25
     26	      =	5432		     target	     EQU   'T2'			     ; Target assembler: TASM-2.X
     27
     28				     include  srmacros.inc
1    29
1    30				     ; Macros which may	be required for	proper re-assembly
1    31
1    32
1    33
1    34
1    35
1    36				     ;-----------------------------------------------------------------------------
1    37				     ; Some assemblers,	like TASM, check each far call and jump, to see	if it is
1    38				     ; in the same segment.  If	so, rather than	produce	the standard five byte far
1    39				     ; instruction it uses a near jump or call.
1    40
1    41				     calls	     macro   dummy1, dummy2, slocation
1    42						     db	     9Ah		     ; forced call far instruction
1    43						     dw	     offset slocation, seg slocation
1    44				     endm
1    45
1    46				     jmps	     macro   dummy1, dummy2, jlocation
1    47						     db	     0EAh		     ; forced jump far instruction
1    48						     dw	     offset jlocation, seg jlocation
1    49				     endm
1    50
1    51
1    52
1    53
1    54				     ;-----------------------------------------------------------------------------
Turbo Assembler	 Version 2.01	     03/22/26 11:45:44	    Page 2
stick.asm



1    55				     ;	Some compilers and some	assemblers will	code a call that goes to a far
1    56				     ;	subroutine in the same segment as:
1    57				     ;
1    58				     ;		     PUSH    CS
1    59				     ;		     CALL    near
1    60				     ;
1    61				     ;	This saves one byte, and is slightly faster.  If the assembler you are
1    62				     ;	using (i.e. MASM, Optasm) does not do this automatically, the following
1    63				     ;	macros are used	to code	the same information.  In other	words, the binary
1    64				     ;	file has "PUSH CS, CALL	near", and Sourcer ensures the same instructions
1    65				     ;	are used!  (macro CALLF)
1    66				     ;
1    67
1    68				     callf	     macro   location
1    69						     push    cs
1    70						     call    near ptr location
1    71				     endm
1    72
1    73				     ;	Some compilers generate	an unnecessary DS override on the call instruction
1    74				     ;	when compacting	the CALLF type function.  Macro	CALLFX handles this case.
1    75
1    76				     callfx	     macro   location
1    77						     push    cs
1    78						     db	     3Eh
1    79						     call    near ptr location
1    80				     endm
1    81
1    82
1    83				     ;-----------------------------------------------------------------------------
1    84				     ;	Some compilers and some	assemblers will	code a near call that is the
1    85				     ;	selected assembler will	convert	to a short jump	to save	a byte.	 This
1    86				     ;	reconstructs a near jump for these cases.
1    87
1    88				     jmpn	     macro   location
1    89						     db	     0E9h
1    90						     dw	     offset location-$-2
1    91				     endm
1    92
1    93
1    94
