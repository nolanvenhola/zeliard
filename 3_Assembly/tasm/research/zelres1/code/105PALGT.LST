      9	      =	5432		     target	     EQU   'T2'			     ; Target assembler: TASM-2.X
     10
     11				     include  srmacros.inc
1    12
1    13				     ; Macros which may	be required for	proper re-assembly
1    14
1    15
1    16
1    17
1    18
1    19				     ;-----------------------------------------------------------------------------
1    20				     ; Some assemblers,	like TASM, check each far call and jump, to see	if it is
1    21				     ; in the same segment.  If	so, rather than	produce	the standard five byte far
1    22				     ; instruction it uses a near jump or call.
1    23
1    24				     calls	     macro   dummy1, dummy2, slocation
1    25						     db	     9Ah		     ; forced call far instruction
1    26						     dw	     offset slocation, seg slocation
1    27				     endm
1    28
1    29				     jmps	     macro   dummy1, dummy2, jlocation
1    30						     db	     0EAh		     ; forced jump far instruction
1    31						     dw	     offset jlocation, seg jlocation
1    32				     endm
1    33
1    34
1    35
1    36
1    37				     ;-----------------------------------------------------------------------------
1    38				     ;	Some compilers and some	assemblers will	code a call that goes to a far
1    39				     ;	subroutine in the same segment as:
1    40				     ;
1    41				     ;		     PUSH    CS
1    42				     ;		     CALL    near
1    43				     ;
1    44				     ;	This saves one byte, and is slightly faster.  If the assembler you are
1    45				     ;	using (i.e. MASM, Optasm) does not do this automatically, the following
1    46				     ;	macros are used	to code	the same information.  In other	words, the binary
1    47				     ;	file has "PUSH CS, CALL	near", and Sourcer ensures the same instructions
1    48				     ;	are used!  (macro CALLF)
1    49				     ;
1    50
1    51				     callf	     macro   location
1    52						     push    cs
1    53						     call    near ptr location
1    54				     endm
Turbo Assembler	 Version 2.01	     03/22/26 12:28:59	    Page 2
105PALGT.asm



1    55
1    56				     ;	Some compilers generate	an unnecessary DS override on the call instruction
1    57				     ;	when compacting	the CALLF type function.  Macro	CALLFX handles this case.
1    58
1    59				     callfx	     macro   location
1    60						     push    cs
1    61						     db	     3Eh
1    62						     call    near ptr location
1    63				     endm
1    64
1    65
1    66				     ;-----------------------------------------------------------------------------
1    67				     ;	Some compilers and some	assemblers will	code a near call that is the
1    68				     ;	selected assembler will	convert	to a short jump	to save	a byte.	 This
1    69				     ;	reconstructs a near jump for these cases.
1    70
1    71				     jmpn	     macro   location
1    72						     db	     0E9h
1    73						     dw	     offset location-$-2
1    74				     endm
1    75
