      1
      2				     ;==========================================================================
      3				     ;
      4				     ;	239DTATB - Data	Tables Module (ZR2_39)
      5				     ;
      6				     ;	NOTE: Original Sourcer disassembly (ZR2_39.ASM)	had 7000+ errors.
      7				     ;	This version emits raw data bytes for bit-perfect output.
      8				     ;
      9				     ;==========================================================================
     10
     11	      =	5432		     target	     EQU     'T2'
     12
     13				     include  srmacros.inc
1    14
1    15				     ; Macros which may	be required for	proper re-assembly
1    16
1    17
1    18
1    19
1    20
1    21				     ;-----------------------------------------------------------------------------
1    22				     ; Some assemblers,	like TASM, check each far call and jump, to see	if it is
1    23				     ; in the same segment.  If	so, rather than	produce	the standard five byte far
1    24				     ; instruction it uses a near jump or call.
1    25
1    26				     calls	     macro   dummy1, dummy2, slocation
1    27						     db	     9Ah		     ; forced call far instruction
1    28						     dw	     offset slocation, seg slocation
1    29				     endm
1    30
1    31				     jmps	     macro   dummy1, dummy2, jlocation
1    32						     db	     0EAh		     ; forced jump far instruction
1    33						     dw	     offset jlocation, seg jlocation
1    34				     endm
1    35
1    36
1    37
1    38
1    39				     ;-----------------------------------------------------------------------------
1    40				     ;	Some compilers and some	assemblers will	code a call that goes to a far
1    41				     ;	subroutine in the same segment as:
1    42				     ;
1    43				     ;		     PUSH    CS
1    44				     ;		     CALL    near
1    45				     ;
1    46				     ;	This saves one byte, and is slightly faster.  If the assembler you are
1    47				     ;	using (i.e. MASM, Optasm) does not do this automatically, the following
1    48				     ;	macros are used	to code	the same information.  In other	words, the binary
1    49				     ;	file has "PUSH CS, CALL	near", and Sourcer ensures the same instructions
1    50				     ;	are used!  (macro CALLF)
1    51				     ;
1    52
1    53				     callf	     macro   location
1    54						     push    cs
Turbo Assembler	 Version 2.01	     03/22/26 13:06:43	    Page 2
239DTATB.asm



1    55						     call    near ptr location
1    56				     endm
1    57
1    58				     ;	Some compilers generate	an unnecessary DS override on the call instruction
1    59				     ;	when compacting	the CALLF type function.  Macro	CALLFX handles this case.
1    60
1    61				     callfx	     macro   location
1    62						     push    cs
1    63						     db	     3Eh
1    64						     call    near ptr location
1    65				     endm
1    66
1    67
1    68				     ;-----------------------------------------------------------------------------
1    69				     ;	Some compilers and some	assemblers will	code a near call that is the
1    70				     ;	selected assembler will	convert	to a short jump	to save	a byte.	 This
1    71				     ;	reconstructs a near jump for these cases.
1    72
1    73				     jmpn	     macro   location
1    74						     db	     0E9h
1    75						     dw	     offset location-$-2
1    76				     endm
1    77
1    78
1    79
     80
     81	0000			     seg_a	     segment byte public
     82						     assume  cs:seg_a, ds:seg_a
     83
     84
