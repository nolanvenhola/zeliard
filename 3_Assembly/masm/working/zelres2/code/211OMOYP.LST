     16
     17				     include  srmacros.inc
1    18
1    19				     ; Macros which may	be required for	proper re-assembly
1    20
1    21
1    22
1    23
1    24
1    25				     ;-----------------------------------------------------------------------------
1    26				     ; Some assemblers,	like TASM, check each far call and jump, to see	if it is
1    27				     ; in the same segment.  If	so, rather than	produce	the standard five byte far
1    28				     ; instruction it uses a near jump or call.
1    29
1    30				     calls	     macro   dummy1, dummy2, slocation
1    31						     db	     9Ah		     ; forced call far instruction
1    32						     dw	     offset slocation, seg slocation
1    33				     endm
1    34
1    35				     jmps	     macro   dummy1, dummy2, jlocation
1    36						     db	     0EAh		     ; forced jump far instruction
1    37						     dw	     offset jlocation, seg jlocation
1    38				     endm
1    39
1    40
1    41
1    42
1    43				     ;-----------------------------------------------------------------------------
1    44				     ;	Some compilers and some	assemblers will	code a call that goes to a far
1    45				     ;	subroutine in the same segment as:
1    46				     ;
1    47				     ;		     PUSH    CS
1    48				     ;		     CALL    near
1    49				     ;
1    50				     ;	This saves one byte, and is slightly faster.  If the assembler you are
1    51				     ;	using (i.e. MASM, Optasm) does not do this automatically, the following
1    52				     ;	macros are used	to code	the same information.  In other	words, the binary
1    53				     ;	file has "PUSH CS, CALL	near", and Sourcer ensures the same instructions
1    54				     ;	are used!  (macro CALLF)
Turbo Assembler	 Version 2.01	     03/28/26 13:08:02	    Page 2
211OMOYP.asm



1    55				     ;
1    56
1    57				     callf	     macro   location
1    58						     push    cs
1    59						     call    near ptr location
1    60				     endm
1    61
1    62				     ;	Some compilers generate	an unnecessary DS override on the call instruction
1    63				     ;	when compacting	the CALLF type function.  Macro	CALLFX handles this case.
1    64
1    65				     callfx	     macro   location
1    66						     push    cs
1    67						     db	     3Eh
1    68						     call    near ptr location
1    69				     endm
1    70
1    71
1    72				     ;-----------------------------------------------------------------------------
1    73				     ;	Some compilers and some	assemblers will	code a near call that is the
1    74				     ;	selected assembler will	convert	to a short jump	to save	a byte.	 This
1    75				     ;	reconstructs a near jump for these cases.
1    76
1    77				     jmpn	     macro   location
1    78						     db	     0E9h
1    79						     dw	     offset location-$-2
1    80				     endm
1    81
1    82
