 = 4D34                         target		EQU   'M4'                      ; Target assembler: MASM-4.0 
                                 
                             C  include  srmacros.inc 
                             C   
                             C  ; Macros which may be required for proper re-assembly 
                             C   
                             C  IF (target EQ 'M4') 
                             C  ;----------------------------------------------------------------------------- 
                             C  ;  MASM 4.0 does not allow retf and retn, allowed by current assemblers. 
                             C  ;  These marcos, convert RETF and RETN into data bytes that are acceptable 
                             C  ;  to MASM 4.0. 
                             C   
                             C   
                             C  retf            macro   ret_count               ; Fixup for Assembler 
                             C                  if      ret_count+0 GT 1 
                             C                  db      0CAh 
                             C                  dw      ret_count 
                             C                  else 
                             C                  db      0CBh 
                             C                  endif 
                             C  endm 
                             C   
                             C  retn            macro  ret_count 
                             C                  if     ret_count+0 GT 1 
                             C                  db     0C2h 
                             C                  dw     ret_count 
                             C                  else 
                             C                  db     0C3h 
                             C                  endif 
                             C  endm 
                             C   
                             C  ENDIF 
                             C   
                             C   
                             C  IF (target EQ 'M4') OR (target EQ 'M5')  
                             C  ;----------------------------------------------------------------------------- 
                             C  ; Due to a bug in earlier MASM assemblers, the valid instruction type  
                             C  ; "mov segreg, reg"  cannot be used, if the register is not AX.   
                             C  ; For example:  mov  es, bx 
                             C   
                             C  movseg          macro reg16, unused, Imm16      ; Fixup for Assembler 
                             C                  ifidn  <reg16>, <bx>             
Microsoft (R) Macro Assembler  Version 4.00                 3/29/26 15:16:32

                                                            Page     1-2
                                                            

                             C                  db     0BBh                      
                             C                  endif                            
                             C                  ifidn  <reg16>, <cx>             
                             C                  db     0B9h                      
                             C                  endif 
                             C                  ifidn  <reg16>, <dx> 
                             C                  db     0BAh 
                             C                  endif 
                             C                  ifidn  <reg16>, <si> 
                             C                  db     0BEh 
                             C                  endif 
                             C                  ifidn  <reg16>, <di> 
                             C                  db     0BFh 
                             C                  endif 
                             C                  ifidn  <reg16>, <bp> 
                             C                  db     0BDh 
                             C                  endif 
                             C                  ifidn  <reg16>, <sp> 
                             C                  db     0BCh 
                             C                  endif 
                             C                  ifidn  <reg16>, <BX> 
                             C                  db     0BBH 
                             C                  endif 
                             C                  ifidn  <reg16>, <CX> 
                             C                  db     0B9H 
                             C                  endif 
                             C                  ifidn  <reg16>, <DX> 
                             C                  db     0BAH 
                             C                  endif 
                             C                  ifidn  <reg16>, <SI> 
                             C                  db     0BEH 
                             C                  endif 
                             C                  ifidn  <reg16>, <DI> 
                             C                  db     0BFH 
                             C                  endif 
                             C                  ifidn  <reg16>, <BP> 
                             C                  db     0BDH 
                             C                  endif 
                             C                  ifidn  <reg16>, <SP> 
                             C                  db     0BCH 
                             C                  endif 
                             C                  dw     seg Imm16 
                             C  endm 
                             C   
                             C  ENDIF 
                             C   
                             C   
                             C  ENDIF 
                             C   
                             C   
                             C   
                             C  IFE (target EQ 'NO') 
                             C  ;----------------------------------------------------------------------------- 
                             C  ;  Some compilers and some assemblers will code a call that goes to a far 
                             C  ;  subroutine in the same segment as: 
Microsoft (R) Macro Assembler  Version 4.00                 3/29/26 15:16:32

                                                            Page     1-3
                                                            

                             C  ; 
                             C  ;               PUSH    CS 
                             C  ;               CALL    near 
                             C  ; 
                             C  ;  This saves one byte, and is slightly faster.  If the assembler you are 
                             C  ;  using (i.e. MASM, Optasm) does not do this automatically, the following 
                             C  ;  macros are used to code the same information.  In other words, the binary 
                             C  ;  file has "PUSH CS, CALL near", and Sourcer ensures the same instructions 
                             C  ;  are used!  (macro CALLF) 
                             C  ; 
                             C   
                             C  callf           macro   location 
                             C                  push    cs 
                             C                  call    near ptr location 
                             C  endm 
                             C   
                             C  ;  Some compilers generate an unnecessary DS override on the call instruction 
                             C  ;  when compacting the CALLF type function.  Macro CALLFX handles this case. 
                             C   
                             C  callfx          macro   location 
                             C                  push    cs 
                             C                  db      3Eh 
                             C                  call    near ptr location 
                             C  endm 
                             C   
                             C   
                             C  ;----------------------------------------------------------------------------- 
                             C  ;  Some compilers and some assemblers will code a near call that is the 
                             C  ;  selected assembler will convert to a short jump to save a byte.  This 
                             C  ;  reconstructs a near jump for these cases. 
                             C   
                             C  jmpn            macro   location 
                             C                  db      0E9h 
                             C                  dw      offset location-$-2 
                             C  endm 
                             C   
                             C  ENDIF 
                             C   
                                 
                                 
                                 
