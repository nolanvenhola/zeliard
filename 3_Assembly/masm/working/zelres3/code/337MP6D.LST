1    17				     ; Macros which may	be required for	proper re-assembly
1    18
1    19
1    20
1    21
1    22
1    23				     ;-----------------------------------------------------------------------------
1    24				     ; Some assemblers,	like TASM, check each far call and jump, to see	if it is
1    25				     ; in the same segment.  If	so, rather than	produce	the standard five byte far
1    26				     ; instruction it uses a near jump or call.
1    27
1    28				     calls	     macro   dummy1, dummy2, slocation
1    29						     db	     9Ah		     ; forced call far instruction
1    30						     dw	     offset slocation, seg slocation
1    31				     endm
1    32
1    33				     jmps	     macro   dummy1, dummy2, jlocation
1    34						     db	     0EAh		     ; forced jump far instruction
1    35						     dw	     offset jlocation, seg jlocation
1    36				     endm
1    37
1    38
1    39
1    40
1    41				     ;-----------------------------------------------------------------------------
1    42				     ;	Some compilers and some	assemblers will	code a call that goes to a far
1    43				     ;	subroutine in the same segment as:
1    44				     ;
1    45				     ;		     PUSH    CS
1    46				     ;		     CALL    near
1    47				     ;
1    48				     ;	This saves one byte, and is slightly faster.  If the assembler you are
1    49				     ;	using (i.e. MASM, Optasm) does not do this automatically, the following
1    50				     ;	macros are used	to code	the same information.  In other	words, the binary
1    51				     ;	file has "PUSH CS, CALL	near", and Sourcer ensures the same instructions
1    52				     ;	are used!  (macro CALLF)
1    53				     ;
1    54
Turbo Assembler	 Version 2.01	     03/22/26 12:39:15	    Page 2
337UTINY.asm



1    55				     callf	     macro   location
1    56						     push    cs
1    57						     call    near ptr location
1    58				     endm
1    59
1    60				     ;	Some compilers generate	an unnecessary DS override on the call instruction
1    61				     ;	when compacting	the CALLF type function.  Macro	CALLFX handles this case.
1    62
1    63				     callfx	     macro   location
1    64						     push    cs
1    65						     db	     3Eh
1    66						     call    near ptr location
1    67				     endm
1    68
1    69
1    70				     ;-----------------------------------------------------------------------------
1    71				     ;	Some compilers and some	assemblers will	code a near call that is the
1    72				     ;	selected assembler will	convert	to a short jump	to save	a byte.	 This
1    73				     ;	reconstructs a near jump for these cases.
1    74
1    75				     jmpn	     macro   location
1    76						     db	     0E9h
1    77						     dw	     offset location-$-2
1    78				     endm
